# Example only: NEVER commit real keys, tokens or customer information.
# Browser Firebase config (from Firebase Console > Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://replace-with-firebase-rtdb-url
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-app-id

# Server only. Use provider secrets, not a tracked .env file.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_DATABASE_URL=https://replace-with-firebase-rtdb-url
FIREBASE_SERVICE_ACCOUNT_JSON=replace-with-service-account-json
DRIVE_SERVICE_ACCOUNT_JSON=replace-with-drive-service-account-json
AMORRI_ADMIN_UIDS=replace-with-admin-uids
DRIVE_VIDEO_SIGNING_SECRET=replace-with-existing-secret-at-least-32-characters
AMORRI_DELIVERY_LINK_KEY=replace-with-existing-delivery-secret-at-least-32-characters

# Current R2-only 1080p service: preserve the names and values already
