# Create /opt/amorri/compose.env from this. chmod 600, NEVER commit.
# Generate with: openssl rand -hex 24 (access key), openssl rand -hex 48 (secret)
AMORRI_S3_ACCESS_KEY_ID=REPLACE_WITH_RANDOM_ALNUM
AMORRI_S3_SECRET_ACCESS_KEY=REPLACE_WITH_LONG_RANDOM_ALNUM
AMORRI_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
