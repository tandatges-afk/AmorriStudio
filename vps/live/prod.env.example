# PRIVATE /etc/amorri/prod.env, owner root:amorri mode 0640
# Quote JSON values with single quotes. DO NOT commit real values.
NODE_ENV=production
PORT=3304
HOSTNAME=127.0.0.1
AMORRI_PUBLIC_ORIGIN=https://amorri.io.vn
NEXT_PUBLIC_AMORRI_AUTH_BACKEND=local
AMORRI_AUTH_BACKEND=local
AMORRI_DATABASE_BACKEND=postgres
DATABASE_URL=postgresql://amorri:REPLACE_POSTGRES_PASSWORD@127.0.0.1:5543/amorri
AMORRI_BRIDGE_SECRET=REPLACE_RANDOM_64_HEX
AMORRI_SESSION_SECRET=REPLACE_DIFFERENT_RANDOM_64_HEX
AMORRI_STORAGE_BACKEND=s3
AMORRI_S3_ENDPOINT=https://media.amorri.io.vn
AMORRI_S3_REGION=us-east-1
AMORRI_S3_VIDEO_BUCKET=amorri-video
AMORRI_S3_CONCEPT_BUCKET=amorri-concept
AMORRI_S3_ACCESS_KEY_ID=REPLACE_ALNUM
AMORRI_S3_SECRET_ACCESS_KEY=REPLACE_ALNUM
# ONLY required during the private export phase; remove from application env AFTER successful cutover.
FIREBASE_PROJECT_ID=REPLACE_OLD_PROJECT
FIREBASE_DATABASE_URL=https://REPLACE.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"REPLACE","private_key":"REPLACE","client_email":"REPLACE"}'
AMORRI_ADMIN_UIDS=REPLACE_UIDS_FROM_OLD_FIREBASE
# Remain unchanged to preserve existing customer delivery/review links:
DRIVE_VIDEO_SIGNING_SECRET=KEEP_ORIGINAL_SECRET
AMORRI_DELIVERY_LINK_KEY=KEEP_ORIGINAL_KEY
DRIVE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"REPLACE","private_key":"REPLACE","client_email":"REPLACE"}'
# R10.2 intentionally excludes ALL pre-existing R2 clips and concept objects.
# Business data and delivery metadata are preserved in PostgreSQL; old clips
# will not play until re-uploaded or explicitly migrated in a future project.
# Newly uploaded media can use the EMPTY VPS S3 buckets above.
AMORRI_LEGACY_R2_MEDIA=skip

# Optional Google Places autocomplete for Admin. Keep server-only; never NEXT_PUBLIC_.
# Enable Places API (New), billing and restrict API key to server IP 180.93.43.162.
# GOOGLE_MAPS_API_KEY=YOUR_SERVER_PLACES_KEY
