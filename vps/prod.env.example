# Template for /etc/amorri/prod.env. Keep this OUTSIDE Git, owned by root:amorri 0640.
# This file is ALSO sourced by /bin/bash for building the website: values with spaces/JSON must be safely single quoted.
NODE_ENV=production
PORT=3304
HOSTNAME=127.0.0.1
AMORRI_PUBLIC_ORIGIN=https://amorri.io.vn
# Stage 1 (safe): r2 remains active; stage 2 after S3 data validation: change to s3.
AMORRI_STORAGE_BACKEND=r2
AMORRI_S3_ENDPOINT=https://media.amorri.io.vn
AMORRI_S3_REGION=us-east-1
AMORRI_S3_VIDEO_BUCKET=amorri-video
AMORRI_S3_CONCEPT_BUCKET=amorri-concept
AMORRI_S3_ACCESS_KEY_ID=REPLACE_WITH_RUSTFS_ACCESS_KEY
AMORRI_S3_SECRET_ACCESS_KEY=REPLACE_WITH_RUSTFS_SECRET_KEY
# Firebase credentials STAY for stage 1. Never replace these with dummy values in a live deployment.
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_EXISTING
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_EXISTING
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_EXISTING
NEXT_PUBLIC_FIREBASE_DATABASE_URL=REPLACE_WITH_EXISTING
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_EXISTING
FIREBASE_PROJECT_ID=REPLACE_WITH_EXISTING
FIREBASE_DATABASE_URL=REPLACE_WITH_EXISTING
FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"REPLACE","client_email":"REPLACE","private_key":"REPLACE"}'
DRIVE_SERVICE_ACCOUNT_JSON='{"project_id":"REPLACE","client_email":"REPLACE","private_key":"REPLACE"}'
AMORRI_ADMIN_UIDS=REPLACE_WITH_EXISTING_UIDS
DRIVE_VIDEO_SIGNING_SECRET=REPLACE_WITH_EXISTING_UNCHANGED
AMORRI_DELIVERY_LINK_KEY=REPLACE_WITH_EXISTING_UNCHANGED
# Keep all existing R2_*, and any other current production secrets until S3 is verified.
